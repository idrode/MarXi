# .env.example — copiar a .env, NUNCA versionar .env real (ya está en .gitignore)

# --- RPC provider dedicado (recomendado para producción/sniping real) ---
# El endpoint público de Robinhood Chain es rate-limited y no pensado para
# tráfico de producción según su propia documentación.
ALCHEMY_API_KEY=
# Endpoint resultante (construido en runtime, no hardcodear aquí):
#   https://robinhood-mainnet.g.alchemy.com/v2/{ALCHEMY_API_KEY}
#   wss://robinhood-mainnet.g.alchemy.com/v2/{ALCHEMY_API_KEY}
# Nota verificada: Alchemy en Robinhood Chain NO soporta Trace API ni Debug
# API todavía — la simulación de transacciones debe apoyarse en eth_call /
# eth_estimateGas, no en debug_traceCall. Revisar si esto cambia.

QUICKNODE_URL=
CHAINSTACK_URL=

# --- Honeypot / seguridad de tokens ---
GOPLUS_API_KEY=

# --- Keystore ---
# La contraseña del keystore NUNCA debería vivir permanentemente en texto
# plano en disco. Esta variable es solo para uso no interactivo (ej. testing
# automatizado en una VM efímera) — para uso normal, se pide por prompt al
# arrancar la app y no se persiste.
# KEYSTORE_PASSWORD=
